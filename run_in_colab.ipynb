    "---\n",
    "## Step 4 — System 1: Reading Time Prediction\n",
    "\n",
    "**Goal:** Train a Ridge regression model that predicts per-word reading time (FFD, FPD, RPD, TD)  \n",
    "from 17 linguistic features (word length, frequency, AoA, surprisal, embedding depth, etc.)\n",
    "\n",
    "**Data:** 50,647 word positions from the Dundee corpus, split 60/20/20 at sentence level  \n",
    "**Expected R² (paper Table 3):** FFD=0.649, FPD=0.600, RPD=0.570, TD=0.516"
   ],
   "id": "markdown-step4"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "# Point the output directory to Drive\n",
    "OUT = os.path.join(PROJECT, 'output')\n",
    "os.makedirs(OUT, exist_ok=True)\n",
    "\n",
    "# Patch the output path in step4 before importing\n",
    "import importlib, types\n",
    "\n",
    "# Run step 4 as a subprocess so its internal paths are correctly set\n",
    "import subprocess, sys\n",
    "result = subprocess.run(\n",
    "    [sys.executable, os.path.join(PROJECT, 'src', 'step4_system1.py')],\n",
    "    capture_output=True, text=True,\n",
    "    env={**os.environ, 'PYTHONPATH': os.path.join(PROJECT, 'src')}\n",
    ")\n",
    "print(result.stdout)\n",
    "if result.returncode != 0:\n",
    "    print('STDERR:', result.stderr)"
   ],
   "id": "cell-step4-run"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Alternative: run step 4 directly in this notebook\n",
    "# (patches the OUT variable so files are read/written from Drive)\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.linear_model import Ridge\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import r2_score\n",
    "import pickle\n",
    "\n",
    "OUT = os.path.join(PROJECT, 'output')\n",
    "\n",
    "FEATURE_GROUPS = [\n",
    "    ('Word Length',             ['wlen']),\n",
    "    ('Sentence Length',         ['sent_len']),\n",
    "    ('Wikipedia Frequency',     ['wiki_freq']),\n",
    "    ('Mean AoA (in years)',     ['aoa_mean']),\n",
    "    ('Standard Dev. in AoA',   ['aoa_std']),\n",
    "    ('Fwd/Bwd Transition Prob', ['fwd_prob', 'bwd_prob']),\n",
    "    ('Lexical Surprisal',       ['lex_surprisal']),\n",
    "    ('Syntactical Surprisal',   ['syn_surprisal']),\n",
    "    ('Entropy Reduction',       ['entropy_red']),\n",
    "    ('Embedding Depth',         ['emb_depth']),\n",
    "    ('Embedding Difference',    ['emb_diff']),\n",
    "    ('Hierarchical structure',  ['h1','h2','h3','h4','h5','h6','h7','h8']),\n",
    "]\n",
    "ALL_FEATURES = [col for _, cols in FEATURE_GROUPS for col in cols]\n",
    "RT_MEASURES  = ['ffd', 'fpd', 'rpd', 'td']\n",
    "\n",
    "print('Loading features...')\n",
    "lex = pd.read_csv(os.path.join(OUT, 'lexical_features.csv'))\n",
    "syn = pd.read_csv(os.path.join(OUT, 'syntactic_features.csv'))\n",
    "\n",
    "word_cols = ['text_id','wnum','sent_id','word','wlen','wiki_freq','aoa_mean','aoa_std','fwd_prob','bwd_prob']\n",
    "avail_cols = [c for c in word_cols if c in lex.columns]\n",
    "word_df = lex[avail_cols].drop_duplicates(subset=['text_id','wnum'])\n",
    "\n",
    "correct_sent_len = word_df.groupby('sent_id')['wnum'].count().rename('sent_len')\n",
    "word_df = word_df.merge(correct_sent_len.reset_index(), on='sent_id', how='left')\n",
    "\n",
    "n_subj  = lex['subj_id'].nunique()\n",
    "rt_avg  = (lex.groupby(['text_id','wnum'])[RT_MEASURES].sum() / n_subj).reset_index()\n",
    "df = word_df.merge(rt_avg, on=['text_id','wnum'], how='left')\n",
    "df[RT_MEASURES] = df[RT_MEASURES].fillna(0.0)\n",
    "df = df.merge(syn, on=['text_id','wnum'], how='left')\n",
    "\n",
    "avail = [c for c in ALL_FEATURES if c in df.columns and df[c].notna().any() and df[c].std() > 0]\n",
    "print(f'  {len(df):,} word positions | {n_subj} subjects | {len(avail)} features')\n",
    "\n",
    "# Sentence-level 60/20/20 split\n",
    "rng = np.random.default_rng(42)\n",
    "sent_ids = df['sent_id'].unique()\n",
    "rng.shuffle(sent_ids)\n",
    "n = len(sent_ids)\n",
    "train_df = df[df['sent_id'].isin(set(sent_ids[:int(n*0.6)]))]\n",
    "dev_df   = df[df['sent_id'].isin(set(sent_ids[int(n*0.6):int(n*0.8)]))]\n",
    "test_df  = df[df['sent_id'].isin(set(sent_ids[int(n*0.8):]))]\n",
    "\n",
    "print(f'  Train: {len(train_df):,} | Dev: {len(dev_df):,} | Test: {len(test_df):,}')"
   ],
   "id": "cell-step4-load"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ablation study (Table 2 in paper) — FFD only\n",
    "print('\\n--- Ablation Study (FFD, Dev Set) ---')\n",
    "print(f'{\"#\":>3}  {\"Features Added\":40s}  {\"R² Score\":>8}  {\"Paper R²\":>8}')\n",
    "paper_r2 = [0.267, 0.500, 0.506, 0.510, 0.516, 0.544, 0.568, 0.575, 0.579, 0.580, 0.581, 0.585]\n",
    "\n",
    "cumcols = []\n",
    "for i, (feat_name, cols) in enumerate(FEATURE_GROUPS, 1):\n",
    "    cumcols.extend([c for c in cols if c in avail])\n",
    "    if not cumcols: continue\n",
    "    sc = StandardScaler()\n",
    "    m = Ridge(alpha=1.0).fit(sc.fit_transform(train_df[cumcols].fillna(0)), train_df['ffd'].values)\n",
    "    r2 = r2_score(dev_df['ffd'].values, m.predict(sc.transform(dev_df[cumcols].fillna(0))))\n",
    "    pr = paper_r2[i-1] if i <= len(paper_r2) else '—'\n",
    "    print(f'{i:>3}  {feat_name:40s}  {r2:>8.3f}  {pr:>8}')"
   ],
   "id": "cell-step4-ablation"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train final models for all 4 RT measures and show Table 3\n",
    "def apply_threshold(preds, thr):\n",
    "    p = preds.copy()\n",
    "    p[p < thr] = 0.0\n",
    "    return p\n",
    "\n",
    "print('\\n--- Final Model Results (Table 3) ---')\n",
    "print(f'{\"Measure\":>10}  {\"Threshold\":>10}  {\"Train R²\":>9}  {\"Dev R²\":>9}  {\"Test R²\":>9}  {\"Paper R²\":>9}')\n",
    "paper = {'ffd': 0.649, 'fpd': 0.600, 'rpd': 0.570, 'td': 0.516}\n",
    "models = {}\n",
    "\n",
    "for rt in RT_MEASURES:\n",
    "    sc = StandardScaler()\n",
    "    X_tr = sc.fit_transform(train_df[avail].fillna(0))\n",
    "    best_a, best_dev = 1.0, -np.inf\n",
    "    for alpha in [0.01, 0.1, 1.0, 10.0, 100.0]:\n",
    "        m = Ridge(alpha=alpha).fit(X_tr, train_df[rt].values)\n",
    "        r2 = r2_score(dev_df[rt].values, m.predict(sc.transform(dev_df[avail].fillna(0))))\n",
    "        if r2 > best_dev: best_dev, best_a = r2, alpha\n",
    "    model = Ridge(alpha=best_a).fit(X_tr, train_df[rt].values)\n",
    "    tr_r2 = r2_score(train_df[rt].values, model.predict(X_tr))\n",
    "\n",
    "    preds_dev = model.predict(sc.transform(dev_df[avail].fillna(0)))\n",
    "    best_thr, best_dr2 = 0, r2_score(dev_df[rt].values, preds_dev)\n",
    "    for thr in range(50, 201):\n",
    "        r2 = r2_score(dev_df[rt].values, apply_threshold(preds_dev.copy(), thr))\n",
    "        if r2 > best_dr2: best_dr2, best_thr = r2, thr\n",
    "\n",
    "    preds_test = apply_threshold(model.predict(sc.transform(test_df[avail].fillna(0))), best_thr)\n",
    "    te_r2 = r2_score(test_df[rt].values, preds_test)\n",
    "    models[rt] = {'model': model, 'scaler': sc, 'threshold': best_thr, 'features': avail}\n",
    "    thr_str = f'{best_thr} ms' if best_thr > 0 else 'none'\n",
    "    print(f'{rt.upper():>10}  {thr_str:>10}  {tr_r2:>9.3f}  {best_dr2:>9.3f}  {te_r2:>9.3f}  {paper[rt]:>9.3f}')\n",
    "\n",
    "# Save models\n",
    "with open(os.path.join(OUT, 'system1_models.pkl'), 'wb') as f:\n",
    "    pickle.dump(models, f)\n",
    "print('\\n✅ Models saved to output/system1_models.pkl')"
   ],
   "id": "cell-step4-results"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Step 5 — System 2: Readability Classification\n",
    "\n",
    "**Goal:** Given a Wikipedia / Simple-Wikipedia sentence pair, classify which is harder to read  \n",
    "**Features:** Predicted FFD (from System 1) for each word position in both sentences  \n",
    "**Classifier:** Logistic Regression, 10-fold cross-validation on **117,712 sentence pairs**  \n",
    "**Expected accuracy (paper Table 5):** Base RT = 73.82%, Extended RT = 75.21%"
   ],
   "id": "markdown-step5"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import math, re\n",
    "import numpy as np, pandas as pd\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.svm import LinearSVC\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.model_selection import StratifiedKFold, cross_val_score\n",
    "\n",
    "# Load System 1 FFD model\n",
    "with open(os.path.join(OUT, 'system1_models.pkl'), 'rb') as f:\n",
    "    sys1 = pickle.load(f)\n",
    "ffd_info = sys1['ffd']\n",
    "print(f'System 1 loaded | threshold={ffd_info[\"threshold\"]} ms | features={len(ffd_info[\"features\"])}')\n",
    "\n",
    "# Load AoA norms\n",
    "aoa_dict = {}\n",
    "aoa_path = os.path.join(PROJECT, 'Dataset', 'AoA.csv')\n",
    "if os.path.exists(aoa_path):\n",
    "    aoa_df = pd.read_csv(aoa_path, encoding='latin-1')\n",
    "    for _, row in aoa_df.iterrows():\n",
    "        w = str(row['Word']).lower().strip()\n",
    "        v = row.get('AoA_Kup', float('nan'))\n",
    "        if not pd.isna(v):\n",
    "            aoa_dict[w] = (float(v), 1.0)\n",
    "    print(f'AoA norms loaded: {len(aoa_dict):,} words')\n",
    "else:\n",
    "    print('AoA file not found — using defaults')\n",
    "\n",
    "# Word frequency (wordfreq library)\n",
    "try:\n",
    "    from wordfreq import word_frequency\n",
    "    def _wf(w): return math.log(word_frequency(w, 'en') + 1e-9)\n",
    "except ImportError:\n",
    "    def _wf(w): return 0.0\n",
    "\n",
    "feat_cols = ffd_info['features']\n",
    "thr       = ffd_info['threshold']\n",
    "\n",
    "def predict_ffd(sentence):\n",
    "    words = sentence.strip().split()\n",
    "    if not words: return []\n",
    "    rows = []\n",
    "    for w in words:\n",
    "        wc = w.lower().strip(\".,!?;:'\\\"()\")\n",
    "        am, as_ = aoa_dict.get(wc, (6.0, 1.0))\n",
    "        rows.append({'wlen': len(wc), 'sent_len': len(words),\n",
    "                     'wiki_freq': _wf(wc), 'aoa_mean': am, 'aoa_std': as_,\n",
    "                     'fwd_prob': 0.0, 'bwd_prob': 0.0, 'total_surprisal': 0.0,\n",
    "                     'lex_surprisal': 0.0, 'syn_surprisal': 0.0, 'entropy_red': 0.0,\n",
    "                     'emb_depth': 0, 'emb_diff': 0,\n",
    "                     'h1':0,'h2':0,'h3':0,'h4':0,'h5':0,'h6':0,'h7':0,'h8':0})\n",
    "    X = pd.DataFrame(rows)[feat_cols].fillna(0)\n",
    "    p = ffd_info['model'].predict(ffd_info['scaler'].transform(X))\n",
    "    p[p < thr] = 0.0\n",
    "    return list(p)\n",
    "\n",
    "print('\\nExample FFD predictions:')\n",
    "sent = 'The cat sat on the mat'\n",
    "ffds = predict_ffd(sent)\n",
    "for w, f in zip(sent.split(), ffds):\n",
    "    print(f'  {w:15s}: {f:.1f} ms')"
   ],
   "id": "cell-step5-setup"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Wikipedia / Simple-Wikipedia pairs\n",
    "wiki_path = os.path.join(PROJECT, 'Dataset', 'Wiki', 'aligned-good(0.67).gz')\n",
    "pairs = []\n",
    "with open(wiki_path, 'r', encoding='utf-8', errors='ignore') as f:\n",
    "    for line in f:\n",
    "        parts = line.strip().split('\\t')\n",
    "        if len(parts) >= 2:\n",
    "            wiki, simple = parts[0].strip(), parts[1].strip()\n",
    "            if wiki != simple and wiki and simple:\n",
    "                pairs.append((simple, wiki))\n",
    "print(f'Loaded {len(pairs):,} Wikipedia / Simple-Wikipedia sentence pairs')\n",
    "print('\\nSample pair:')\n",
    "print(f'  Wikipedia:  {pairs[5][1][:90]}')\n",
    "print(f'  Simple WP:  {pairs[5][0][:90]}')"
   ],
   "id": "cell-step5-pairs"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build feature matrix  (takes ~10–15 minutes for all 117K pairs)\n",
    "MAX_WORDS = 60\n",
    "print(f'Building Base RT feature matrix for {len(pairs):,} pairs...')\n",
    "print('(This takes ~10–15 minutes)')\n",
    "\n",
    "X_rows, y_rows = [], []\n",
    "for i, (simple, wiki) in enumerate(pairs):\n",
    "    if i % 25000 == 0: print(f'  {i:,} / {len(pairs):,}')\n",
    "    wf = predict_ffd(wiki)[:MAX_WORDS]\n",
    "    sf = predict_ffd(simple)[:MAX_WORDS]\n",
    "    wf += [0.0] * (MAX_WORDS - len(wf))\n",
    "    sf += [0.0] * (MAX_WORDS - len(sf))\n",
    "    X_rows.append(wf + sf); y_rows.append(1)   # wiki = harder = label 1\n",
    "    X_rows.append(sf + wf); y_rows.append(0)   # simple = easier = label 0\n",
    "\n",
    "X_base = np.array(X_rows, dtype=np.float32)\n",
    "y      = np.array(y_rows, dtype=np.int32)\n",
    "print(f'\\n✅ Feature matrix: {X_base.shape}  ({X_base.shape[0]:,} instances × {X_base.shape[1]} features)')"
   ],
   "id": "cell-step5-features"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extended features: add sentence length + mean FFD + sum surprisal\n",
    "extra_rows = []\n",
    "for simple, wiki in pairs:\n",
    "    ww, sw = wiki.split(), simple.split()\n",
    "    wf, sf = predict_ffd(wiki), predict_ffd(simple)\n",
    "    extra_rows.append([len(ww), len(sw),\n",
    "                       float(np.mean(wf)) if wf else 0.0,\n",
    "                       float(np.mean(sf)) if sf else 0.0,\n",
    "                       0.0, 0.0])  # surprisal sum = 0 (BNC not available in Colab)\n",
    "    extra_rows.append([len(sw), len(ww),\n",
    "                       float(np.mean(sf)) if sf else 0.0,\n",
    "                       float(np.mean(wf)) if wf else 0.0,\n",
    "                       0.0, 0.0])\n",
    "\n",
    "X_ext = np.hstack([X_base, np.array(extra_rows, dtype=np.float32)])\n",
    "print(f'Extended feature matrix: {X_ext.shape}')"
   ],
   "id": "cell-step5-extended"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 10-fold cross-validation\n",
    "cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=42)\n",
    "\n",
    "print('\\n--- System 2 Results (10-fold Cross-Validation) ---')\n",
    "print(f'{\"Model\":55s}  {\"Our Acc\":>8}  {\"Paper\":>8}')\n",
    "print('-' * 75)\n",
    "\n",
    "targets = {'Base RT + Pairwise Classification': (X_base, 0.7382),\n",
    "           'Extended RT + Pairwise Classification': (X_ext, 0.7521)}\n",
    "\n",
    "for label, (X, paper_acc) in targets.items():\n",
    "    sc = StandardScaler()\n",
    "    X_s = sc.fit_transform(X)\n",
    "    lr = LogisticRegression(max_iter=1000, C=1.0, random_state=42)\n",
    "    scores = cross_val_score(lr, X_s, y, cv=cv, scoring='accuracy', n_jobs=-1)\n",
    "    print(f'{label:55s}  {scores.mean()*100:>7.2f}%  {paper_acc*100:>7.2f}%')\n",
    "\n",
    "print()\n",
    "print('✅ Pipeline complete!')"
   ],
   "id": "cell-step5-results"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
