   {
    "k": 24,
    "a": "இவர் சாகித்திய அகாதெமி விருதும் ஞானபீட விருதும் வாங்கினார். இவர் எழுதிய புத்தகங்கள் வேறு மொழிகளிலும் வந்துள்ளன.",
    "b": "சாகித்திய அகாதெமி விருதையும் ஞானபீட விருதையும் பெற்ற இவருடைய படைப்புகள், பிறமொழிகளில் மொழிபெயர்க்கப்பட்டுள்ளன."
   },
   {
    "k": 25,
    "a": "இந்த ராணி நல்ல வேலைகள் செய்தார். அதனால் வரலாற்றில் இடம் பெற்றார். வாருங்கள், அவரைப் பற்றிப் படிக்கலாம்.",
    "b": "தன்னுடைய சிறந்த பணிகளால் சரித்திரத்தில் இடம் பெற்ற இந்த ராணியைப் பற்றிப் படிக்க வாருங்கள்."
   },
   {
    "k": 26,
    "a": "இவர், திருவள்ளூர் மாவட்டத்தில் உள்ள அம்பத்தூரில், காமராஜர் அரசு பெண்கள் மேல்நிலைப் பள்ளியில் அறிவியல் பாடப்பிரிவில் படித்தவர்.",
    "b": "இவர் திருவள்ளூர் மாவட்டம் அம்பத்தூரில் உள்ள காமராஜர் அரசு பெண்கள் மேல்நிலைப் பள்ளியில் படித்தார். அங்கே அறிவியல் பிரிவில் படித்தார்."
   },
   {
    "k": 27,
    "a": "வேணு தன் கையில் இருந்த பணப்பையைக் கீழே போட்டான். பிறகு சந்திரனின் கையைப் பிடித்துக் குலுக்கினான்.",
    "b": "வேணு தன் கையிலிருந்த பர்ஸைக் கீழே போட்டுவிட்டுச் சந்திரனின் கரத்தைப் பற்றிக் குலுக்கினான்."
   },
   {
    "k": 28,
    "a": "இந்தியாவில் காவல் உதவி ஆய்வாளர் ஆன முதல் திருநங்கை இவர்தான்.",
    "b": "இந்தியாவின் முதல் திருநங்கை காவல் உதவி ஆய்வாளர் என்ற பெருமை இவரைச் சாரும்."
   },
   {
    "k": 29,
    "a": "அவர்கள் தங்கள் இடத்தை விட்டுப் பிரிந்து வந்துவிட்டார்கள். மீண்டும் வீடு திரும்ப வழி தெரியாமல் கஷ்டப்படுகிறார்கள். இதையும் இந்தப் புத்தகம் சொல்கிறது.",
    "b": "எப்படி தங்கள் இடத்தில் இருந்து பிரிந்து வந்துவிட்ட பிறகு, மீண்டும் தங்கள் இடத்திற்கு திரும்பிச் செல்ல வழி இல்லாமல் தவிக்கிறார்கள் என்பதையும் விவரிக்கிறது."
   },
   {
    "k": 30,
    "a": "என் நாடகக் குழுவுடன் சேர்ந்து வேலை செய்வது எனக்கு மிகவும் பிடிக்கும். மக்கள் நேரில் பாராட்டுவதும் பிடிக்கும். இது வேறு எதிலும் கிடைக்காத மகிழ்ச்சி. இதுதான் எனக்குப் பெரிய ஆறுதல்.",
    "b": "என்றாலும் எனது குழுவினரோடு நாடக நாள்களில் ஒன்றுபட்டுச் செயல்படுவதில் காணும் இன்பமும், மக்களின் பாராட்டுதலை நேருக்குநேர் பெறும் வாய்ப்பும், எனக்கு எதிலும் பெறமுடியாத ஒரு தனி மகிழ்ச்சியைத் தருகிறது என்ற உண்மை ஒன்றே எனக்குக் கிடைக்கும் பெரும் ஆறுதலாகும்."
   }
  ]
 },
 {
  "no": 2,
  "items": [
   {
    "k": 1,
    "a": "அங்கே இந்தக் கல்வி முறைக்கு மெட்ராஸ் சிஸ்டம், பெல் சிஸ்டம், மானிடரி சிஸ்டம் என்று பல பெயர்கள் இருந்தன.",
    "b": "அங்கு இக்கல்விமுறை மெட்ராஸ் சிஸ்டம், பெல் சிஸ்டம் மற்றும் மானிடரி சிஸ்டம் என்றும் அழைக்கப்பட்டது."
   },
   {
    "k": 2,
    "a": "அதன் விளைவாக, நம் கல்விமுறை மாற்றமும் ஏற்றமும் பெற்று, தமிழ்நாடு நாட்டிலேயே முன்னோடி மாநிலமாக விளங்குகிறது.",
    "b": "இதனால் நம் கல்வி முறை மாறி, முன்னேறியது. இந்தியாவிலேயே தமிழ்நாடு முன்னோடி மாநிலமாக இருக்கிறது."
   },
   {
    "k": 3,
    "a": "பொறியாளர் விஸ்வா, அணைக்கட்டுகள், பாலங்கள் மற்றும் பல நிறுவனங்களை உருவாக்கி, நவீன இந்தியாவுக்கான அடித்தளத்தை அமைத்தார்.",
    "b": "விஸ்வா ஒரு பொறியாளர். அவர் அணைகளையும் பாலங்களையும் பல நிறுவனங்களையும் கட்டினார். இப்படிப் புதிய இந்தியாவுக்கு அடித்தளம் போட்டார்."
   },
   {
    "k": 4,
    "a": "அவர்களுடைய அப்பா ஒரு மாலுமி. அவர் கப்பலில் காம்போஜாவுக்குப் போனார். இன்னும் திரும்பி வரவில்லை. ஏன் என்று தெரியாமல் அவர்கள் கவலைப்பட்டார்கள்.",
    "b": "மாலுமியாக காம்போஜா சென்ற தங்கள் தந்தை கடல் பயணத்திலிருந்து இன்னமும் திரும்பி வராத காரணம் தெரியாமல் கவலையுடன் இருந்தார்கள்."
   },
   {
    "k": 5,
    "a": "இவர் தமிழிலும் மலையாளத்திலும் எழுதினார். கதைகளும் நாவல்களும் எழுதினார்.",
    "b": "இவர் தமிழிலும் மலையாளத்திலும் புதினம், சிறுகதை போன்ற பல்வேறு இலக்கியத் தளங்களில் இயங்கியவர்."
   },
   {
    "k": 6,
    "a": "அதுவே சிறந்த நேர மேலாண்மை என்பதைத்தான் தொன்மை மிகுந்த இந்தச் சீனக்கதை சொல்கிறது.",
    "b": "நேரத்தைச் சரியாகப் பயன்படுத்துவது எப்படி என்று இந்தப் பழைய சீனக் கதை சொல்கிறது."
   },
   {
    "k": 7,
    "a": "அவர்கள் அனைவரும் கணினிகள் மற்றும் நிரலாக்கத்தின் மீதான நமது பார்வையில் தாக்கத்தை ஏற்படுத்தி உள்ளனர்.",
    "b": "கணினிகளைப் பற்றி நாம் நினைப்பதை அவர்கள் எல்லோரும் மாற்றினார்கள். கணினிக்கு நிரல் எழுதுவதைப் பற்றி நாம் நினைப்பதையும் மாற்றினார்கள்."
   },
   {
    "k": 8,
    "a": "ஒன்று, கோபி ஒரு முட்டாளாக இருக்க வேண்டும். அல்லது, தான் தைரியசாலி என்று பெருமை பேச முயன்றிருக்க வேண்டும்.",
    "b": "ஒன்று கோபி முட்டாளாய் இருக்க வேண்டும் அல்லது தான் தைரியசாலி எனப் பீற்றிக் கொள்ள முயற்சித்திருக்க வேண்டும்."
   },
   {
    "k": 9,
    "a": "அவர் கீழே கிடந்த கருப்புச் சேற்றை அள்ளினார். அதை அதன் மேல் நன்றாகப் பூசி மூடினார்.",
    "b": "அதன் மேல் கீழே கிடந்த கரிய சேற்றை அள்ளி நன்றாகப் பூசி மூடினார்."
   },
   {
    "k": 10,
    "a": "வாருங்கள், நமது இரட்டைத் துப்பறிவாளர்களுடன் சேர்ந்து ஒரு அற்புதமான கணிதப் பயணத்தை மேற்கொள்வோம்.",
    "b": "வாருங்கள்! நம் இரண்டு துப்பறியும் நண்பர்களுடன் சேர்ந்து ஒரு அருமையான கணிதப் பயணம் போகலாம்."
   },
   {
    "k": 11,
    "a": "எல்லோருக்கும் ஒரு அக்கா அல்லது அண்ணன் இருக்கிறார்கள். நம்மால் செய்ய முடியாததை அவர்களால் செய்ய முடியும்.",
    "b": "ஒவ்வொருவருக்கும் ஒரு அக்கா அல்லது சகோதரன் இருக்கிறார்கள், அவர்களால் முடியாததைச் செய்ய முடியும்."
   },
   {
    "k": 12,
    "a": "துறைமுகம், கூனன் தோப்பு ஆகிய இவரின் படைப்புகள் தமிழக அரசின் விருது பெற்றுள்ளன.",
    "b": "இவர் துறைமுகம், கூனன் தோப்பு என்ற புத்தகங்களை எழுதினார். அவற்றுக்குத் தமிழக அரசு விருது கொடுத்தது."
   },
   {
    "k": 13,
    "a": "அந்த அலங்குக்கு ஒரு நல்ல வீடு வேண்டும். காட்டு அதிகாரிகளும் காட்டு விலங்குகளைக் காக்கும் குழுவினரும் உதவுகிறார்கள். பயிற்சி பெற்ற இரண்டு நாய்களும் உதவுகின்றன.",
    "b": "வன அதிகாரிகளும், காட்டுயிர் பாதுகாப்பு அறக்கட்டளைக் குழுவினரும், காட்டுயிர் பாதுகாப்பில் பழக்கப்படுத்தப்பட்ட இரண்டு நாய்களும் இணைந்து கச்சிதமான ஒரு வீட்டைக் கண்டறிய அந்த அலங்குக்கு உதவுகிறார்கள்."
   },
   {
    "k": 14,
    "a": "மிகவும் பிஸியான திரைப்பட நடிகனாக இருந்தபோதும் ஐம்பது வயதுவரை சொந்தமாக நாடகக் கம்பெனி நடத்தி, அரங்கங்களில் நடித்தும் வந்தார்.",
    "b": "அவர் திரைப்படங்களில் நடிப்பதில் மிகவும் வேலையாக இருந்தார். ஆனாலும் ஐம்பது வயது வரை தன் சொந்த நாடகக் குழுவை நடத்தினார். மேடையிலும் நடித்தார்."
   },
   {
    "k": 15,
    "a": "ஒரு பெரிய காட்டில், தொலைவிலுள்ள பகுதியில், ஏராளமான ஏரிகள், குளங்கள் மற்றும் ஓடைகள் இருந்தன.",
    "b": "ஒரு பெரிய காடு இருந்தது. அதன் ஒரு தூரமான பகுதியில் நிறைய ஏரிகளும் குளங்களும் ஓடைகளும் இருந்தன."
   },
   {
    "k": 16,
    "a": "ஒரு ஆலிவ் ரிட்லி ஆமையின் அழகான வாழ்க்கைக் கதையைப் படியுங்கள். வழியில் இன்னும் பல அதிசய உயிரினங்களையும் பாருங்கள்.",
    "b": "ஒரு ஆலிவ் ரிட்லி ஆமையின் இந்த அழகான வாழ்க்கைக் கதையைக் கண்டுபிடி, மேலும் பல சுவாரஸ்யமான உயிரினங்களை வழியில் சந்திக்கவும்."
   },
   {
    "k": 17,
    "a": "கீழ்வாயிலக்கம், மேல்வாயிலக்கம், குழிமாற்று, நெல் இலக்கம் முதலிய வாய்பாடுகளைக் கட்டாயம் மனப்பாடம் செய்யவேண்டும்.",
